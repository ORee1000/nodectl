# 宿主机监听端口（默认只绑定 127.0.0.1）
NODECTL_PORT=7878

# 持久化数据目录
NODECTL_DATA_DIR=./data

# 默认镜像；Alpha 可改为 ghcr.io/oree1000/nodectl:alpha
NODECTL_IMAGE=ghcr.io/oree1000/nodectl:latest

# 本机回环访问可启用 HTTP。公网部署应配置 HTTPS 后改为 false。
NODECTL_ALLOW_INSECURE_HTTP=true

# TLS 在反向代理终止时，填写代理 IP/CIDR；多个值以逗号分隔。
NODECTL_TRUSTED_PROXIES=

TZ=Asia/Shanghai
